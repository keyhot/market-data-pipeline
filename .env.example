# Postgres (docker-compose up -d)
# Defaults are for local development only — set a strong POSTGRES_PASSWORD in
# .env before exposing the stack beyond localhost (the DB port is published).
POSTGRES_DB=market_data
POSTGRES_USER=market_data
POSTGRES_PASSWORD=market_data
POSTGRES_PORT=5432
DATABASE_URL=postgresql://market_data:market_data@localhost:5432/market_data

# In-memory response cache
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=256

# Background ingestion scheduler (config/watchlist.yaml)
SCHEDULER_ENABLED=false

# Binance websocket 1m-kline ingester (crypto watchlist symbols)
WS_INGEST_ENABLED=false

# Published API port for the docker-compose api service
API_PORT=8000
