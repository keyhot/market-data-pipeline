# Postgres (docker-compose up -d)
# Defaults are for local development only — set a strong POSTGRES_PASSWORD in
# .env before exposing the stack beyond localhost (the DB port is published).
POSTGRES_DB=market_data
POSTGRES_USER=market_data
POSTGRES_PASSWORD=market_data
POSTGRES_PORT=5432
DATABASE_URL=postgresql://market_data:market_data@localhost:5432/market_data

# In-memory response cache
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=256

# Background ingestion scheduler (config/watchlist.yaml)
SCHEDULER_ENABLED=false

# Binance websocket 1m-kline ingester (crypto watchlist symbols)
WS_INGEST_ENABLED=false

# Published API port for the docker-compose api service
API_PORT=8000

# OBS websocket control (Sprint 11 stream tooling: scripts/stream_ctl.py)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=changeme
# Base URL the OBS browser sources load pages from
STREAM_PAGE_BASE=http://localhost:8000
# RTMP output — the key comes from the platform and is NEVER committed
OBS_STREAM_SERVER=rtmp://a.rtmp.youtube.com/live2
OBS_STREAM_KEY=
# Directory of DMCA-safe audio loops wired into the scene (optional)
STREAM_AUDIO_DIR=
# Stream lifecycle events spool here when Postgres is unreachable
STREAM_EVENT_SPOOL=data/stream_events.spool.jsonl

# freqtrade dry-run sidecar (Sprint 12) — the trader inhabitant.
# Never a real key: dry_run is true and the exchange block is keyless.
FREQTRADE_URL=http://freqtrade:8080
FREQTRADE_USERNAME=worldwatcher
FREQTRADE_PASSWORD=
# Must be long — freqtrade rejects short values as a fatal config error.
FREQTRADE_JWT_SECRET=
# Set to 0 to disable the trader-mirror scheduler job.
TRADER_MIRROR_ENABLED=1

# Director service (Sprint 13) — opt-in compose profile:
#   docker compose --profile director up
# Needs OBS reachable (host); kept out of the default stack so the core boots
# without OBS. Set to 0 to make the service exit cleanly if it does start.
DIRECTOR_ENABLED=1
# Where the director reads /world/state. On the host: http://localhost:8000;
# the compose service overrides this to http://api:8000.
DIRECTOR_STATE_URL=http://localhost:8000
# Local Piper TTS — one voice per personality. Voice models (<voice>.onnx) are
# large and installed out-of-band (not committed); the director degrades to
# silence if the binary or a voice is missing.
PIPER_BIN=piper
PIPER_VOICE_DIR=voices
