    "/music/now-playing": {
      "get": {
        "description": "The bed's current track, for the credit line on the signals strip.\n\nRead-only and forgiving: the bed is a courtesy (neither Mixkit's nor\nPixabay's licence requires attribution), so a missing runner, a stale row\nor a DB blip all answer `{\"playing\": null}` rather than an error. The strip\nthen shows nothing at all, which is the correct look for a stream with no\nmusic.",
        "operationId": "music_now_playing_music_now_playing_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
