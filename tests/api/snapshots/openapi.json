    "/charts": {
      "get": {
        "description": "Multi-symbol chart page (chart-focus scene): one candlestick panel per\nwatchlist `predict` symbol \u2014 BTC *and* ETH \u2014 each with prediction markers.\n\n`?symbols=BTCUSDT` narrows it to a subset. That exists so a scene needing a\nsingle-symbol chart uses this chrome-free broadcast surface instead of\n`/chart/{symbol}`, whose nav link, status line and footer are meant for a\nhuman with a browser and went out on air until KI-027.",
        "operationId": "charts_charts_get",
        "parameters": [
          {
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": "1d",
              "title": "Interval",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "symbols",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Symbols"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
