    "/standby": {
      "get": {
        "description": "Procedural standby card for the `standby` OBS scene (B10).\n\nUnknown states fall back rather than erroring: this page is the surface\nshown *because* something already went wrong, so it must never be the thing\nthat breaks. The state is escaped, never trusted \u2014 it reaches the DOM as\ntext through a template substitution, the same rule as every other page.",
        "operationId": "standby_page_standby_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "default": "reconnecting",
              "title": "State",
              "type": "string"
